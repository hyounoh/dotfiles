{{- /* machine profile: personal (default) or work (work laptop) */ -}}
{{- $profile := promptChoiceOnce . "profile" "machine profile" (list "personal" "work") "personal" -}}

{{- $defaultName  := "hyounoh" -}}
{{- $defaultEmail := "hyounoh@users.noreply.github.com" -}}
{{- if eq $profile "work" -}}
{{-   $defaultName  = "hyounoh" -}}
{{-   $defaultEmail = "hyounoh@users.noreply.github.com" -}}
{{- end -}}

{{- $name  := promptStringOnce . "name"  "git user.name"  $defaultName -}}
{{- $email := promptStringOnce . "email" "git user.email" $defaultEmail -}}

[data]
    profile = {{ $profile | quote }}
    name    = {{ $name    | quote }}
    email   = {{ $email   | quote }}
