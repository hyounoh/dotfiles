{{- /* machine profile: personal (default) or work */ -}}
{{- $profile := promptChoiceOnce . "profile" "machine profile" (list "personal" "work") "personal" -}}

{{- /* 두 프로필 모두 사용자가 명시적으로 입력. 소스에 개인/회사 identity를 박지 않는다 */ -}}
{{- $name  := promptStringOnce . "name"  "git user.name"  "" -}}
{{- $email := promptStringOnce . "email" "git user.email" "" -}}

[data]
    profile = {{ $profile | quote }}
    name    = {{ $name    | quote }}
    email   = {{ $email   | quote }}
