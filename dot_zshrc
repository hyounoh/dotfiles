# ── Oh My Zsh ─────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""  # disabled: using starship
plugins=(git)
source "$ZSH/oh-my-zsh.sh"

# ── Cargo ─────────────────────────────────────────────────
[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

# ── Modular configs ──────────────────────────────────────
for f in ~/.zshrc.d/*.zsh(N); do source "$f"; done
