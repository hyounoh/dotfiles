# ── 코드 검색 / 텍스트 처리 ──
brew "ripgrep"      # rg: 빠른 코드 검색
brew "jq"           # JSON 처리
brew "yq"           # YAML 처리 (jq의 YAML 버전)
brew "fzf"          # 퍼지 인터랙티브 검색
brew "fd"           # find 대체 (빠르고 직관적)
brew "bat"          # cat 대체 (syntax highlight, Git 통합)
brew "util-linux"   # GNU column (macOS 기본 column 기능 제한)
brew "watch"        # 주기적 명령 실행 (macOS 기본 없음)
brew "miller"       # mlr: CSV/TSV/JSON 파이프라인 처리
brew "tidy-viewer"  # tv: CSV 컬러 테이블 출력

# ── Git / GitHub ──
brew "git"          # 최신 버전 (macOS 기본 git은 구버전)
brew "gh"           # GitHub CLI: PR, issue, workflow 관리
brew "lazygit"      # Git TUI
brew "delta"        # git diff syntax highlight + side-by-side

# ── 터미널 생산성 ──
brew "tmux"                     # 터미널 세션 관리 / 분할 창
brew "btop"                     # 인터랙티브 리소스 모니터링 (htop 상위호환)
brew "eza"                      # ls 대체 (컬러, 아이콘, Git 상태)
brew "zoxide"                   # cd 스마트 대체 (자주 가는 디렉토리 학습)
brew "atuin"                    # 히스토리 검색 DB (Ctrl-R 대체)
brew "gum"                      # 스크립트용 TUI 컴포넌트 (choose/confirm/spin)
brew "zsh-autosuggestions"      # zsh 명령어 자동완성 제안
brew "zsh-syntax-highlighting"  # zsh 명령어 구문 하이라이팅

# ── 프롬프트 / 폰트 / 터미널 ──
brew "starship"                 # 빠른 크로스쉘 프롬프트
brew "chezmoi"                  # dotfiles 관리
cask "font-meslo-lg-nerd-font"  # Nerd Font (eza/starship 아이콘)
cask "ghostty"                  # 터미널 앱

# ── 네트워크 ──
brew "wget"         # curl 대안 (파일 다운로드)
brew "nmap"         # 포트 스캔 / 네트워크 탐색
brew "gping"        # ping 그래프 시각화
brew "doggo"        # 모던 DNS 클라이언트 (dig 대체)

# ── 암호화 ──
brew "openssl@3"    # LibreSSL보다 기능 풍부한 OpenSSL

# ── JVM / Java ──
# JDK는 mise로 관리 (cask temurin은 sudo 프롬프트 필요로 brew bundle에서 제외)
brew "gradle"       # Gradle 빌드 도구 (프로젝트 wrapper 없을 때)
brew "mise"         # JDK·Node 등 런타임 버전 관리

# ── 컨테이너 ──
brew "lazydocker"   # Docker TUI (docker CLI / compose는 Docker Desktop에 포함)

# ── DB 클라이언트 ──
brew "mysql-client" # mysql CLI (서버 없이 클라이언트만)
brew "lazysql"      # DB TUI (MySQL/PostgreSQL/SQLite)
brew "redis"        # redis-cli 포함

# ── Kafka ──
brew "kafka"        # kafka-topics.sh, kafka-console-consumer.sh 등 포함
brew "kcat"         # 유연한 Kafka CLI (Avro / Schema Registry 지원)

# ── 인프라 / 클라우드 ──
brew "awscli"           # AWS CLI
brew "saml2aws"         # SAML SSO → AWS 임시 크레덴셜
brew "kubernetes-cli"   # kubectl
brew "kubectx"          # k8s 컨텍스트/네임스페이스 전환
brew "k9s"              # Kubernetes TUI
brew "helm"             # k8s 패키지 매니저
brew "eksctl"           # EKS 클러스터 관리
